{
  "name": "leptonica-wasm",
  "version": "0.1.0",
  "description": "Modern ESM/WASM build of Leptonica — curated image operators with a raw C-ABI escape hatch",
  "type": "module",
  "license": "BSD-2-Clause",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.13.0",
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "vendor/versions.json"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./raw": {
      "types": "./src/raw/index.ts",
      "import": "./src/raw/index.ts"
    },
    "./full-abi/leptonica.mjs": {
      "types": "./dist/full-abi/leptonica-raw.d.ts",
      "import": "./dist/full-abi/leptonica.mjs"
    },
    "./full-abi/leptonica.wasm": {
      "default": "./dist/full-abi/leptonica.wasm"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
